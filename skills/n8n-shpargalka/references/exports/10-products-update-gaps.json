  {
   "parameters": {
    "jsCode": "// Какие поля обязаны быть заполнены у карточки перед публикацией\nconst REQUIRED = ['style', 'material', 'room', 'palette'];\nconst TAG = 'needs:data';\n\nconst p = $input.first().json.data.product;\nconst missing = REQUIRED.filter((k) => {\n  const v = p[k] && p[k].value;\n  if (!v) return true;\n  // списочные метаполя приходят JSON-строкой: \"[]\" тоже пусто\n  const t = String(v).trim();\n  return t === '' || t === '[]';\n});\nconst hasTag = (p.tags || []).includes(TAG);\n\n// Меняем тег только если он не в нужном состоянии. Иначе ничего не делаем:\n// лишний tagsAdd сам вызывает products/update, и получился бы круг.\nlet action = 'none';\nif (missing.length && !hasTag) action = 'add';\nif (!missing.length && hasTag) action = 'remove';\n\nreturn [{ json: { id: p.id, title: p.title, status: p.status, missing, hasTag, tag: TAG, action } }];\n"
   },
