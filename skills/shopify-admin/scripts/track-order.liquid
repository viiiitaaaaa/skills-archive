{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} isolate">
  <div
    class="contact page-width page-width--narrow section-{{ section.id }}-padding"
    style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="rte track-order__intro">{{ section.settings.subheading }}</div>
    {%- endif -%}

    <form class="track-order__form" id="TrackOrder-{{ section.id }}" novalidate>
      <div class="field">
        <input
          type="text"
          id="TrackNumber-{{ section.id }}"
          class="field__input"
          name="tracking_number"
          autocomplete="off"
          spellcheck="false"
          placeholder=" "
          required
        >
        <label class="field__label" for="TrackNumber-{{ section.id }}">
          {{ section.settings.input_label }}
        </label>
      </div>

      <p class="track-order__error" id="TrackError-{{ section.id }}" hidden>
        {{ section.settings.error_text }}
      </p>

      <button type="submit" class="button">{{ section.settings.button_label }}</button>
    </form>

    {%- if section.settings.footnote != blank -%}
      <div class="rte track-order__footnote">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</div>

<style>
  .track-order__intro,
  .track-order__footnote { margin-bottom: 2.4rem; }
  .track-order__footnote { margin-top: 3.2rem; opacity: .75; font-size: 1.4rem; }
  .track-order__form .field { margin-bottom: 1.6rem; }
  .track-order__error { color: rgb(var(--color-foreground)); font-size: 1.4rem; margin: 0 0 1.6rem; }
</style>

<script>
  (function () {
    var form = document.getElementById('TrackOrder-{{ section.id }}');
    if (!form) return;
    var input = document.getElementById('TrackNumber-{{ section.id }}');
    var error = document.getElementById('TrackError-{{ section.id }}');

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var value = (input.value || '').replace(/[^A-Za-z0-9]/g, '');
      if (value.length < 8) {
        error.hidden = false;
        input.focus();
        return;
      }
      error.hidden = true;
      var url = {{ section.settings.tracker_url | json }} + encodeURIComponent(value);
      window.open(url, '_blank', 'noopener');
    });
  })();
</script>

{% schema %}
{
  "name": "Track order",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your order" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "subheading", "label": "Text above the field" },
    { "type": "text", "id": "input_label", "label": "Field label", "default": "Tracking number" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Track" },
    { "type": "text", "id": "error_text", "label": "Error text", "default": "Please enter a valid tracking number." },
    { "type": "text", "id": "tracker_url", "label": "Tracker URL prefix", "default": "https://t.17track.net/en#nums=" },
    { "type": "richtext", "id": "footnote", "label": "Footnote" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "presets": [{ "name": "Track order" }]
}
{% endschema %}
