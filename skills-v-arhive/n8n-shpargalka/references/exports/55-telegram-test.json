   ]
  },
  {
   "parameters": {
    "jsCode": "const r = $input.first().json;\nconst err = r.error || r;\nconst msg = (err && (err.description || err.message)) || JSON.stringify(err).slice(0, 300);\nlet hint = '';\nif (/chat not found/i.test(msg)) hint = 'Бот не знает этот чат: напишите боту /start и запустите python scripts\\\\telegram\\\\setup_telegram.py.';\nelse if (/unauthorized|not found/i.test(msg)) hint = 'Токен неверный или бот удалён: проверьте первую строку «telegram bot.txt».';\nreturn [{ json: { 'связь': 'нет', 'ошибка': msg, 'подсказка': hint } }];"
   },
