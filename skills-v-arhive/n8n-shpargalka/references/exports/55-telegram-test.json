        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "id": "f7000000-0000-4000-8000-000000000003",
   "name": "Telegram настроен?",
