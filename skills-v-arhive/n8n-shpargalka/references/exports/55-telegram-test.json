  {
   "parameters": {
    "jsCode": "const token = $env.TELEGRAM_BOT_TOKEN || '';\nconst chat = $env.TELEGRAM_CHAT_ID || '';\nif (!token || !chat) {\n  return [{ json: { ok: false, telegram_on: false,\n    'связь': 'нет',\n    'причина': 'n8n запущен без ключей Telegram. Нужен файл «telegram bot.txt» рядом с ключами Shopify (токен и chat_id) и перезапуск .\\\\n8n\\\\start-n8n.ps1.' } }];\n}\nconst now = new Date().toLocaleString('ru-RU', { timeZone: 'Europe/Warsaw' });\nreturn [{ json: { ok: true, telegram_on: true, text: `🔔 ARTMELLIO: проверка связи из панели, ${now}` } }];"
   },
   "id": "f7000000-0000-4000-8000-000000000002",
   "name": "Есть ли ключи",
