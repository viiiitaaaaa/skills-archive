  {
   "parameters": {
    "jsCode": "const r = $input.first().json;\nconst m = r.result || {};\nreturn [{ json: {\n  'связь': 'есть',\n  'чат': String(m.chat && (m.chat.username ? '@' + m.chat.username : m.chat.first_name || m.chat.title || m.chat.id)),\n  'сообщение': 'отправлено, проверьте Telegram',\n} }];"
   },
   "id": "f7000000-0000-4000-8000-000000000005",
   "name": "Итог",
